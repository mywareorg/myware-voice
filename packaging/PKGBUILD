# Maintainer: Sean Wu <sean@mywareorg.example>
#
# The sherpa-onnx runtime is a second source with the checksum from `sherpa.lock`,
# rather than a script run in `prepare`: makepkg should see every download and
# every hash in one place.
#
# The source is the tag's archive, not a branch. `pkgver` has to be bumped with
# the tag, and `prepare` refuses a tree whose Cargo.toml disagrees, so a stale
# number fails the build instead of shipping a package that calls itself 0.2.0.
pkgname=myware-voice
pkgver=0.2.0
pkgrel=1
pkgdesc='Push-to-talk dictation for sway/Wayland, with a local speech model'
arch=('x86_64')
url='https://gitlab.com/mywareorg/myware-voice'
license=('LGPL-2.1-only')
# The settings window is iced, which wants a Wayland client and xkbcommon at link
# time; cpal wants ALSA. `wl-clipboard` is not optional: without wl-copy the
# daemon refuses to record.
depends=('gcc-libs' 'wl-clipboard' 'libnotify' 'hicolor-icon-theme' 'alsa-lib' 'libxkbcommon' 'wayland')
makedepends=('cargo' 'rust' 'pkgconf')
optdepends=(
    'wtype: paste without uinput access'
    'ydotool: paste where wtype is unavailable'
)
source=(
    "$pkgname-$pkgver.tar.gz::$url/-/archive/v$pkgver/$pkgname-v$pkgver.tar.gz"
    "sherpa-onnx-v1.13.8-linux-x64-shared.tar.bz2::https://github.com/k2-fsa/sherpa-onnx/releases/download/v1.13.8/sherpa-onnx-v1.13.8-linux-x64-shared.tar.bz2"
)
sha256sums=(
    '2c336d12a1ea8b198b670b1360f48308966e80127977a151f87a7366f884ad25'
    'c0bdb7907d3a74bba1d55d22bf4d9fa75586cf1530614ebe88a27b9118e015c4'
)

prepare() {
    cd "$pkgname-v$pkgver"
    if ! grep -q "^version = \"$pkgver\"$" Cargo.toml; then
        error "Cargo.toml does not say version $pkgver; bump pkgver with the tag"
        return 1
    fi
}

build() {
    cd "$pkgname-v$pkgver"
    # The workspace, not just the daemon: the tray launches the settings window
    # from the daemon's own directory, and the popup is a second binary.
    cargo build --release --workspace --locked
}

check() {
    cd "$pkgname-v$pkgver"
    # No model and no microphone: every test that needs them uses a fake.
    cargo test --workspace --locked
}

package() {
    cd "$pkgname-v$pkgver"
    local libdir="$pkgdir/usr/lib/$pkgname"

    install -d "$libdir/lib" "$pkgdir/usr/bin" "$pkgdir/usr/share/applications"
    install -m 755 target/release/myware-voice \
        target/release/myware-voice-daemon \
        target/release/myware-voice-settings \
        target/release/myware-voice-overlay "$libdir/"
    # sherpa-onnx and onnxruntime together: the SONAME is resolved through the
    # shared object's own $ORIGIN rpath.
    install -m 644 "$srcdir/sherpa-onnx-v1.13.8-linux-x64-shared/lib/"*.so "$libdir/lib/"

    for binary in myware-voice myware-voice-daemon myware-voice-settings myware-voice-overlay; do
        ln -s "/usr/lib/$pkgname/$binary" "$pkgdir/usr/bin/$binary"
    done

    install -m 644 packaging/myware-voice.desktop \
        "$pkgdir/usr/share/applications/myware-voice.desktop"

    local size
    for size in 16x16 22x22 24x24 32x32 48x48 64x64 128x128 256x256 512x512; do
        install -Dm644 "packaging/hicolor/$size/apps/myware-voice.png" \
            "$pkgdir/usr/share/icons/hicolor/$size/apps/myware-voice.png"
    done

    # The packaged unit runs the packaged binary, not the per-user install.
    install -Dm644 packaging/systemd/myware-voice.service \
        "$pkgdir/usr/lib/systemd/user/myware-voice.service"
    sed -i 's|%h/\.local/libexec/myware-voice/myware-voice|/usr/bin/myware-voice|' \
        "$pkgdir/usr/lib/systemd/user/myware-voice.service"

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
